# ── deploy.env — production secrets for the VM ───────────────────────────
# Copy this to `deploy.env` ON THE SERVER and fill in real values.
# `deploy.env` is gitignored — never commit it.
#   cp deploy.env.example deploy.env  &&  nano deploy.env

# Postgres (the DB stays private to the compose network)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=ssjd_db

# First admin, seeded on boot (idempotent). Use a strong password.
ADMIN_EMAIL=admin@ssjd.coop
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# JWT — generate with:  openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Razorpay (use fresh test or live keys — do NOT reuse leaked ones)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Brevo / SendinBlue email (optional)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@ssjd.org
BREVO_SENDER_NAME=SSJD Cooperative

# Twilio WhatsApp (optional — ROTATE the leaked token before using)
NOTIFY_WA_PROVIDER=twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WA_FROM=whatsapp:+14155238886

# ── Database ──────────────────────────────────────────────────────────────
# Local dev (host Postgres):
DATABASE_URL=postgresql://postgres:password@localhost:5432/ssjd_db
# Docker compose uses: postgresql://postgres:password@db:5432/ssjd_db

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── First-admin seed (optional; used by `python -m app.seed`) ─────────────────
ADMIN_EMAIL=admin@ssjd.coop
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Administrator
SOCIETY_NAME=SSJD Cooperative Society

# ── Razorpay (https://dashboard.razorpay.com) ────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Brevo / SendinBlue email (https://app.brevo.com) ──────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SSJD Cooperative
